<% layout('layouts/boilerplate') %>
<div class="head mt-4">
  <h1>Listing details.</h1>
</div>

<div class="row align-items-start mt-0">
  <div class="col-md-5">
    <div class="card-body px-0">
        <br><br>
      <p class="card-text">
        Description: <p><%= listing.description %></p>
        Price: &#8377; <%= listing.price.toLocaleString('en-IN') %><br><br>
        Location: <%= listing.location %><br><br>
        Country: <%= listing.country %><br><br>
      </p>
    </div>
    <br>
<hr>
    <div class="btns" style="display: flex; align-items: center; gap: 10px;">
      <button class="btn btn-dark" style="background-color: #fe424d;">
        <a style="text-decoration: none; color: white;" href="/listings/<%= listing._id %>/edit">Edit</a>
      </button>
      <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="margin: 0;">
        <button class="btn btn-dark" type="submit">Delete</button>
      </form>
      
</div>
  </div>

  <div class="col-md-7">
    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
    <h2><%= listing.title %></h2>
  </div>

</div>
  <br>
  <br>